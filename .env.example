# Local demo uses SQLite unless DATABASE_URL is provided. Docker uses PostGIS.
DATABASE_URL=postgresql+psycopg://ner_lens:ner_lens_demo@localhost:5432/ner_lens
POSTGRES_DB=ner_lens
POSTGRES_USER=ner_lens
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
WEATHER_API_KEY=
SATELLITE_API_KEY=
SMS_API_KEY=
EMAIL_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEMO_MODE=true
MAX_UPLOAD_MB=10
